        "severity":  "low",
        "confidence":  0.5,
        "mitre_attack":  "T1055",
        "created_at":  "2026-05-24",
        "hit_count":  0,
        "false_positive":  true,
        "filter":  {
                       "condition":  "processName matches browser list AND sizeKB \u003c 1024 AND type == MEM_PRIVATE",
                       "action":  "downgrade_to_info"
                   }
    },
