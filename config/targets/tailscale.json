{
  "keyword": "tailscale",
  "process_names": ["tailscale", "tailscaled"],
  "service_names": ["Tailscale"],
  "registry_keys": [
    "HKLM\\SOFTWARE\\Tailscale IPN",
    "HKCU\\Software\\Tailscale IPN"
  ],
  "search_roots": [
    "%ProgramFiles%\\Tailscale",
    "%ProgramData%\\Tailscale",
    "%LOCALAPPDATA%\\Tailscale"
  ],
  "search_depth": 3,
  "max_files": 200,
  "hash_only_paths": [
    "*.state",
    "*.key",
    "*.pem",
    "*.pfx",
    "*.conf",
    "*.config",
    "*.json",
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    "*.log",
    "*.bak"
  ],
  "copy_extensions": [
    ".exe",
    ".dll",
    ".sys",
    ".msi",
    ".bat",
    ".cmd",
    ".ps1",
    ".vbs",
    ".js",
    ".jar",
    ".py"
  ]
}
